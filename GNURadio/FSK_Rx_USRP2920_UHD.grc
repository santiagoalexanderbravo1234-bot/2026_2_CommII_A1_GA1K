- name: adaptacion_tasa
  id: rational_resampler_xxx
  parameters:
    alias: ''
    affinity: ''
    minoutbuf: '0'
    maxoutbuf: '0'
    type: ccc
    interp: interp_rx
    decim: decim_rx
    taps: ''
    fbw: '0.4'
    comment: 250 -> 96 kS/s (48/125), Sps = 10
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 280
    - 496
    rotation: 0
    state: enabled
- name: filtro_canal
  id: low_pass_filter
  parameters:
