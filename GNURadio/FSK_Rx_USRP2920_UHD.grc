options:
  parameters:
    author: Grupo A1-GG
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Recibe la senal de FSK_DCI_Fase3_Tx_USRP2920. Filtro de canal, discriminador de frecuencia, filtro acoplado, correccion del desvio Tx-Rx, sincronismo de bit (Gardner) y deteccion del mensaje.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: FSK_Rx_USRP2920_UHD
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'FSK Rx USRP-2920 a 895 MHz: recepcion del mensaje conocido'
    window_size: (1300,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: Rb
  id: variable
  parameters:
    value: '9600'
    comment: Tasa de bits [b/s] (igual al Tx)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 136
    rotation: 0
    state: enabled
- name: Sps
  id: variable
  parameters:
    value: '10'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 96
    - 136
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    value: Rb*Sps
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 184
    - 136
    rotation: 0
    state: enabled
- name: h
  id: variable
  parameters:
    value: '1.0'
    comment: Indice de modulacion (igual al Tx)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 296
    - 136
    rotation: 0
    state: enabled
- name: desviacion
  id: variable
  parameters:
    value: h*Rb/2
    comment: Desviacion de frecuencia [Hz] (igual al Tx)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 384
    - 136
    rotation: 0
    state: enabled
- name: mensaje
  id: variable
  parameters:
    value: '"UIS - Comunicaciones II - Grupo A1-GG - Enlace FSK DCI. "'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 472
    - 136
    rotation: 0
    state: enabled
- name: samp_rate_usrp
  id: variable
  parameters:
    value: 250e3
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 224
    rotation: 0
    state: enabled
- name: interp_rx
  id: variable
  parameters:
    value: int(samp_rate/math.gcd(int(samp_rate_usrp),int(samp_rate)))
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 184
    - 224
    rotation: 0
    state: enabled
- name: decim_rx
  id: variable
  parameters:
    value: int(samp_rate_usrp/math.gcd(int(samp_rate_usrp),int(samp_rate)))
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 320
    - 224
    rotation: 0
    state: enabled
- name: fc
  id: variable
  parameters:
    value: 895e6
    comment: Misma portadora del Tx
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 456
    - 224
    rotation: 0
    state: enabled
- name: usrp_addr
  id: variable
  parameters:
    value: '"addr=192.168.10.2"'
    comment: IP de la USRP receptora
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 560
    - 224
    rotation: 0
    state: enabled
- name: bw_canal
  id: variable
  parameters:
    value: desviacion + Rb
    comment: 'Corte del filtro de canal: media banda de Carson'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 312
    rotation: 0
    state: enabled
- name: trans_canal
  id: variable
  parameters:
    value: Rb/2
    comment: Banda de transicion del filtro de canal
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 120
    - 312
    rotation: 0
    state: enabled
- name: alpha_dc
  id: variable
  parameters:
    value: 1.0/(Sps*1000)
    comment: Constante del promedio (~1000 bits) que estima el desvio Tx-Rx
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 232
    - 312
    rotation: 0
    state: enabled
- name: clk_bw
  id: variable
  parameters:
    value: '0.045'
    comment: Ancho de banda del lazo de sincronismo de bit
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 352
    - 312
    rotation: 0
    state: enabled
- name: media_nrz
  id: variable
  parameters:
    value: 2.0*sum(bin(c).count('1') for c in mensaje.encode('ascii'))/(8*len(mensaje)) - 1
    comment: Valor medio de los bits NRZ del mensaje (para no confundirlo con desvio de frecuencia)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 456
    - 312
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters:
    alias: ''
    imports: import math
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 392
    rotation: 0
    state: enabled
- name: ganancia_rx
  id: variable_qtgui_range
  parameters:
    label: '"Ganancia Rx [dB]"'
    rangeType: float
    value: '20'
    start: '0'
    stop: '31.5'
    step: '0.5'
    widget: counter_slider
    orient: QtCore.Qt.Horizontal
    min_len: '200'
    gui_hint: 0,0,1,2
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 880
    - 8
    rotation: 0
    state: enabled
