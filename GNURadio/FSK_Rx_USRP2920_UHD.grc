- name: detector_mensaje
  id: epy_block
  parameters:
    alias: ''
    affinity: ''
    minoutbuf: '0'
    maxoutbuf: '0'
    _source_code: "\"\"\"\nDetector del mensaje conocido para FSK binaria (recepcion con USRP).\nEntrada: una muestra blanda por bit (salida del Symbol Sync): cerca de +1 para el\ntono alto (fc + desviacion, bit 1) y cerca de -1 para el tono bajo (fc - desviacion, bit 0).\nEl receptor real tiene incognitas que el simulador no tenia; aqui se resuelven asi:\n  - umbral de decision: punto medio entre los dos niveles recibidos (k-medias con 2 grupos),\n    para que un desvio de frecuencia residual o un mensaje con mas ceros que unos no lo sesgue,\n  - polaridad (tonos intercambiados si el espectro llega invertido),\n  - en que bit empieza cada byte (8 posibilidades),\n  - en que caracter del mensaje empieza la ventana.\nComo el mensaje es conocido, se prueban las 16 combinaciones de polaridad y alineacion y se\nelige la que mas caracteres acierta; con ella se muestran el texto recibido y la tasa de error\nde caracter.\n\"\"\"\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    def __init__(self, mensaje='UIS - Comunicaciones II - Grupo A1-GG - Enlace FSK DCI. ', ventanas=2):\n        gr.sync_block.__init__(self, name='Detector de mensaje FSK', in_sig=[np.float32], out_sig=None)\n        self.ref = np.frombuffer(mensaje.encode('ascii'), dtype=np.uint8)\n        self.L = len(self.ref)\n        self.nb = self.L * ventanas                    # bytes por ventana de analisis\n        self.nbits = 8 * self.nb + 7                   # bits por ventana (+7 para probar alineaciones)\n        self.buf = np.zeros(0, dtype=np.float32)\n        # tabla de referencia con todos los desplazamientos ciclicos del mensaje\n        idx = (np.arange(self.L)[:, None] + np.arange(self.nb)[None, :]) % self.L\n        self.ref_shifts = self.ref[idx]                # (L, nb)\n        self.ultimo = ''\n        self.invertida = False\n        self.n_car = 0\n        self.n_err = 0\n        self.cer_ventana = 1.0\n        self.snr_db = 0.0\n        self.enganchado = False\n\n    def _umbral(self, x):\n        u = float(np.mean(x))\n        for _ in range(10):\n            alto = x[x > u]\n            bajo = x[x <= u]\n            if len(alto) == 0 or len(bajo) == 0:\n                return u\n            nuevo = 0.5 * (float(alto.mean()) + float(bajo.mean()))\n            if abs(nuevo - u) < 1e-6:\n                break\n            u = nuevo\n        d = 0.5 * (float(alto.mean()) - float(bajo.mean()))\n        var = (float(alto.var()) * len(alto) + float(bajo.var()) * len(bajo)) / len(x)\n        self.snr_db = 10.0 * np.log10(d * d / var) if var > 0 else 99.0\n        return u\n\n    def _analizar(self, x):\n        u = self._umbral(x)\n        bits = (x > u).astype(np.uint8)\n        mejor = (-1, 0, 0, None)\n        for pol in (0, 1):\n            bp = bits ^ pol\n            for off in range(8):\n                b = np.packbits(bp[off:off + 8 * self.nb])          # MSB primero\n                aciertos = (self.ref_shifts == b[None, :]).sum(axis=1)\n                k = int(np.argmax(aciertos))\n                if aciertos[k] > mejor[0]:\n                    mejor = (int(aciertos[k]), pol, k, b)\n        acier, pol, k, b = mejor\n        self.invertida = bool(pol)\n        self.cer_ventana = 1.0 - acier / self.nb\n        # el conteo empieza cuando el receptor se engancha (primera ventana con menos de 25 % de\n        # error), para que la adquisicion del sincronismo de bit no infle la tasa de error\n        if not self.enganchado and self.cer_ventana < 0.25:\n            self.enganchado = True\n        if self.enganchado:\n            self.n_car += self.nb\n            self.n_err += self.nb - acier\n        ini = (-k) % self.L                            # posicion donde empieza el mensaje\n        linea = b[ini:ini + self.L]\n        self.ultimo = ''.join(chr(c) if 32 <= c < 127 else '?' for c in linea)\n\n    def work(self, input_items, output_items):\n        x = input_items[0]\n        self.buf = np.concatenate((self.buf, x))\n        while len(self.buf) >= self.nbits:\n            self._analizar(self.buf[:self.nbits])\n \
      \           self.buf = self.buf[self.nbits:]\n        return len(x)\n\n    def texto(self):\n        return self.ultimo\n\n    def tasa_error_caracter(self):\n        return self.n_err / self.n_car if self.n_car else 0.0\n\n    def estado(self):\n        if not self.enganchado:\n            return 'Buscando el mensaje...'\n        return 'Enganchado | polaridad %s | error ultima ventana: %.1f %% | SNR en el decisor: %.1f dB' % (\n            'invertida' if self.invertida else 'normal', 100 * self.cer_ventana, self.snr_db)\n"
    comment: ''
    mensaje: mensaje
    ventanas: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1660
    - 488
    rotation: 0
    state: enabled
